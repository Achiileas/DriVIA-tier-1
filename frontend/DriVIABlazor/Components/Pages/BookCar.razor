@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "CUSTOMER")]

@page "/book-car/{VehicleId:long}"
@rendermode InteractiveServer

@using DriVIABlazor.Models
@using DriVIABlazor.Services
@inject CarApiService CarApiService

<PageTitle>Book a Car - DriVIA</PageTitle>

<h3>Book a Car</h3>

@if (loading)
{
    <p>Loading vehicle details...</p>
}
else if (errorMessage != "")
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}
else if (car != null)
{
    <h4>@car.Model</h4>

    <p><strong>Category:</strong> @car.Category</p>
    <p><strong>Gearbox:</strong> @car.Gearbox</p>
    <p><strong>Location:</strong> @car.LocationName</p>
    <p><strong>Price per day:</strong> @car.PricePerDay DKK</p>

    <hr />

    <h4>Reservation Details</h4>

    <div class="mb-3">
        <label>Pickup Date and Time</label>
        <input type="datetime-local"
               class="form-control"
               min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
               @bind="reservation.PickupDate"
               @bind:after="ResetEstimate" />
    </div>

    <div class="mb-3">
        <label>Return Date and Time</label>
        <input type="datetime-local"
               class="form-control"
               min="@reservation.PickupDate.ToString("yyyy-MM-ddTHH:mm")"
               @bind="reservation.ReturnDate"
               @bind:after="ResetEstimate" />
    </div>

    @if (estimatedPrice > 0)
    {
        <div class="alert alert-info">
            <h5>Estimated Rental Price</h5>

            <p>Price per day: @car.PricePerDay DKK</p>
            <p>Rental days: @rentalDays</p>
            <p><strong>Total: @estimatedPrice DKK</strong></p>
        </div>
    }

    <button class="btn btn-primary"
            @onclick="HandleBooking">
        Continue
    </button>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="@messageClass mt-3">
            @message
        </div>
    }
}

@code {
    [Parameter]
    public long VehicleId { get; set; }

    [SupplyParameterFromQuery(Name = "pickup")]
    public DateTime? SearchPickup { get; set; }

    [SupplyParameterFromQuery(Name = "returnDate")]
    public DateTime? SearchReturn { get; set; }

    private Car? car;
    private CreateReservationRequest reservation = new();

    private bool loading = true;
    private string errorMessage = "";
    private string message = "";
    private string messageClass = "";

    private int rentalDays;
    private decimal estimatedPrice;

    private void ResetEstimate()
    {
        estimatedPrice = 0;
        rentalDays = 0;
        message = "";
        messageClass = "";
    }

    protected override async Task OnParametersSetAsync()
    {
        reservation.VehicleId = VehicleId;

        ResetEstimate();

        reservation.PickupDate = SearchPickup ?? default;
        reservation.ReturnDate = SearchReturn ?? default;

        loading = true;
        errorMessage = "";
        car = null;

        try
        {
            car = await CarApiService.GetCarByIdAsync(VehicleId);

            if (car == null)
            {
                errorMessage =
                    "The selected vehicle could not be found.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = GetFriendlyError(ex);
        }
        finally
        {
            loading = false;
        }
    }

    private string GetFriendlyError(Exception ex)
    {
        if (ex.Message ==
            "Unable to connect to the service. Please try again later." ||
            ex.Message ==
            "The request timed out. Please try again.")
        {
            return ex.Message;
        }

        foreach (System.Net.HttpStatusCode code in
                 Enum.GetValues<System.Net.HttpStatusCode>())
        {
            if (ex.Message == ApiErrorHelper.GetErrorMessage(code))
            {
                return ex.Message;
            }
        }

        return "Unable to load vehicle details. Please try again later.";
    }

    private void ShowValidationError(string error)
    {
        message = error;
        messageClass = "alert alert-danger";
    }

    private void HandleBooking()
    {
        ResetEstimate();

        if (reservation.PickupDate == default)
        {
            ShowValidationError(
                "Please select a pickup date and time.");
            return;
        }

        if (reservation.ReturnDate == default)
        {
            ShowValidationError(
                "Please select a return date and time.");
            return;
        }

        if (reservation.PickupDate <= DateTime.Now)
        {
            ShowValidationError(
                "Pickup date and time must be in the future.");
            return;
        }

        if (reservation.ReturnDate <= reservation.PickupDate)
        {
            ShowValidationError(
                "Return date and time must be after the pickup date and time.");
            return;
        }

        if (car == null)
        {
            ShowValidationError(
                "Vehicle information is unavailable. Please try again.");
            return;
        }

        TimeSpan rentalPeriod =
            reservation.ReturnDate - reservation.PickupDate;

        rentalDays = (int)Math.Ceiling(rentalPeriod.TotalDays);

        estimatedPrice = rentalDays * car.PricePerDay;

        message =
            "Reservation details validated. Booking is not connected yet.";

        messageClass = "alert alert-info";
    }
}
