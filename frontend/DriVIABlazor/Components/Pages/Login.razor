@page "/login"
@rendermode InteractiveServer

@using DriVIABlazor.Models

@inject DriVIABlazor.Services.LoginService LoginService
@inject DriVIABlazor.Services.SimpleAuthService SimpleAuthService
@inject NavigationManager Navigation

<PageTitle>Login - DriVIA</PageTitle>

<div class="login-page">

    <div class="login-banner">

        <div class="brand-logo">
            Dri<span>VIA</span>
        </div>

        <div class="banner-content">

            <span class="banner-tag">
                PREMIUM CAR RENTAL
            </span>

            <h1>
                Your journey.<br />
                Your freedom.
            </h1>

            <p>
                Discover Denmark at your own pace.
                Your next adventure starts with DriVIA.
            </p>

            <div class="banner-features">
                <span>✓ Quality vehicles</span>
                <span>✓ Flexible rentals</span>
                <span>✓ Easy booking</span>
            </div>

        </div>

        <div class="banner-footer">
            DriVIA — Drive with confidence.
        </div>

    </div>

    <div class="login-panel">

        <div class="login-card">

            <a href="/" class="back-home">
                ← Back to home
            </a>

            <div class="login-icon">

                <svg width="30"
                     height="30"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.7">

                    <rect x="4"
                          y="10"
                          width="16"
                          height="11"
                          rx="3" />

                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                    <path d="M12 14v3" />

                </svg>

            </div>

            <h2>Welcome back!</h2>

            <p class="login-subtitle">
                Sign in to continue your DriVIA journey.
            </p>

            <EditForm Model="@loginRequest"
                      OnValidSubmit="@HandleLogin"
                      FormName="LoginForm">

                <DataAnnotationsValidator />

                <div class="login-field">

                    <label for="username">
                        Username
                    </label>

                    <InputText id="username"
                               class="login-input"
                               placeholder="Enter your username"
                               autocomplete="username"
                               @bind-Value="loginRequest.Username" />

                    <ValidationMessage For="@(() => loginRequest.Username)" />

                </div>

                <div class="login-field">

                    <label for="password">
                        Password
                    </label>

                    <div class="password-wrapper">

                        <InputText id="password"
                                   type="@(showPassword ? "text" : "password")"
                                   class="login-input"
                                   placeholder="Enter your password"
                                   autocomplete="current-password"
                                   @bind-Value="loginRequest.Password" />

                        <button type="button"
                                class="password-toggle"
                                @onclick="TogglePassword">

                            @(showPassword ? "Hide" : "Show")

                        </button>

                    </div>

                    <ValidationMessage For="@(() => loginRequest.Password)" />

                </div>

                <button type="submit"
                        class="login-submit"
                        disabled="@isLoading">

                    @(isLoading ? "Signing in..." : "Sign in →")

                </button>

            </EditForm>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="@(loginSuccessful ? "login-success" : "login-error")"
                     role="status">

                    @message

                </div>
            }

            <div class="login-divider">
                <span>NEW TO DRIVIA?</span>
            </div>

            <div class="login-footer">

                Don't have an account?

                <a href="/register">
                    Create an account
                </a>

                <p class="mt-3">
                    © @DateTime.Now.Year DriVIA Car Rental
                </p>

            </div>

        </div>

    </div>

</div>

@code {
    private LoginRequest loginRequest = new();

    private string message = "";
    private bool isLoading = false;
    private bool showPassword = false;
    private bool loginSuccessful = false;

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private async Task HandleLogin()
    {
        if (isLoading)
        {
            return;
        }

        message = "";
        loginSuccessful = false;

        if (string.IsNullOrWhiteSpace(loginRequest.Username))
        {
            message = "Please enter your username.";
            return;
        }

        if (string.IsNullOrWhiteSpace(loginRequest.Password))
        {
            message = "Please enter your password.";
            return;
        }

        isLoading = true;

        try
        {
            var response = await LoginService.LoginAsync(loginRequest);

            if (response != null &&
                response.UserId > 0 &&
                !string.IsNullOrWhiteSpace(response.Name) &&
                !string.IsNullOrWhiteSpace(response.Role))
            {
                SimpleAuthService.Login(
                    response.Name,
                    response.Role,
                    response.UserId
                );

                loginSuccessful = true;
                message = "Login successful!";

                if (response.Role == "CUSTOMER")
                {
                    Navigation.NavigateTo("/my-reservations");
                }
            }
            else
            {
                message = "Invalid username or password. Please try again.";
            }
        }
        catch (HttpRequestException)
        {
            message = "Unable to connect to the server. Please try again later.";
        }
        catch (TaskCanceledException)
        {
            message = "The request timed out. Please try again.";
        }
        catch (Exception)
        {
            message = "Login failed. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
