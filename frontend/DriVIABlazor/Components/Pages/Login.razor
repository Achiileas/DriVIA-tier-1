
@page "/login"
@rendermode InteractiveServer

@using DriVIABlazor.Models

@inject DriVIABlazor.Services.LoginService LoginService
@inject DriVIABlazor.Services.SimpleAuthService SimpleAuthService
@inject NavigationManager Navigation

<h3>Login</h3>

<EditForm Model="@loginRequest"
          OnValidSubmit="@HandleLogin"
          FormName="LoginForm">

    <DataAnnotationsValidator />

    <div class="mb-3">
        <label>Username</label>
        <InputText class="form-control"
                   @bind-Value="loginRequest.Username" />
    </div>

    <div class="mb-3">
        <label>Password</label>
        <InputText type="password"
                   class="form-control"
                   @bind-Value="loginRequest.Password" />
    </div>

    <button type="submit"
            class="btn btn-primary"
            disabled="@isLoading">
        @(isLoading ? "Logging in..." : "Login")
    </button>

</EditForm>

<p>@message</p>

@code {
    private LoginRequest loginRequest = new();
    private string message = "";
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        message = "";

        try
        {
            var response = await LoginService.LoginAsync(loginRequest);

            if (response != null &&
                response.UserId > 0 &&
                !string.IsNullOrWhiteSpace(response.Name) &&
                !string.IsNullOrWhiteSpace(response.Role))
            {
                SimpleAuthService.Login(
                    response.Name,
                    response.Role,
                    response.UserId
                );

                message = "Login successful!";

                if (response.Role == "CUSTOMER")
                {
                    Navigation.NavigateTo("/my-reservations");
                }
            }
            else
            {
                message = "Invalid login information.";
            }
        }
        catch (HttpRequestException)
        {
            message = "Cannot connect to the server.";
        }
        catch (Exception)
        {
            message = "Login failed. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
