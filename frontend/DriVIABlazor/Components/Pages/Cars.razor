
@page "/cars"
@rendermode InteractiveServer

@using DriVIABlazor.Models
@using DriVIABlazor.Services
@inject CarApiService CarApiService
@inject LocationApiService LocationApiService
@inject NavigationManager Navigation


<h3>Browse Cars</h3>


<p>Search for cars at DriVIA Car Rental</p>


@if (SearchPickup.HasValue && SearchReturn.HasValue)
{
    <div class="alert alert-info">
        <strong>Selected rental period</strong>

        <p>
            Pickup:
            @SearchPickup.Value.ToString("dd MMM yyyy HH:mm")
        </p>

        <p>
            Return:
            @SearchReturn.Value.ToString("dd MMM yyyy HH:mm")
        </p>
    </div>
}


<div class="mb-3">
    <label class="form-label">Model</label>
    <input class="form-control"
           placeholder="Enter car model"
           @bind="searchModel" />
</div>


<div class="mb-3">
    <label class="form-label">Category</label>
    <select class="form-control" @bind="selectedCategory">
        <option value="">All Categories</option>
        @foreach (var category in cars.Select(c => c.Category).Distinct())
        {
            <option value="@category">@category</option>
        }
    </select>
</div>


<div class="mb-3">
    <label class="form-label">Maximum Price (DKK/day)</label>
    <input type="number"
           class="form-control"
           min="0"
           placeholder="Enter maximum price"
           @bind="maximumPrice" />
</div>

<div class="mb-3">
    <label class="form-label">Location</label>
    <select class="form-control" @bind="selectedLocation">
        <option value="">All Locations</option>
        @foreach (var location in cars.Select(c => c.Location).Distinct())
        {
            <option value="@location">@location</option>
        }
    </select>
</div>

<div class="mb-3">
    <label class="form-label">Gearbox</label>
    <select class="form-control" @bind="selectedGearbox">
        <option value="">All Gearboxes</option>
        @foreach (var gearbox in cars.Select(c => c.Gearbox).Distinct())
        {
            <option value="@gearbox">@gearbox</option>
        }
    </select>
</div>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="SearchCars">
        Search
    </button>

    
<button class="btn btn-secondary" @onclick="ClearSearch">
    Clear Filters
</button>

</div>


@if (loading)
{
    <p>Loading cars...</p>
}
else if (errorMessage != null)
{
    <p class="text-danger">@errorMessage</p>
}
else if (filteredCars.Count == 0)
{
    @if (cars.Count == 0 &&
         SearchPickup.HasValue &&
         SearchReturn.HasValue &&
         !string.IsNullOrWhiteSpace(SearchLocation))
    {
        <p>
            No cars are available at the selected location
            for this rental period. Please try different dates.
        </p>
    }
    else
    {
        <p>No cars found matching your search.</p>
    }
}

else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Model</th>
                <th>Category</th>
                <th>Price (DKK/day)</th>
                <th>Location</th>
                <th>Gearbox</th>
                <th>Booking</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var car in filteredCars)
            {
                
                <tr>
                    <td>@car.Id</td>
                    <td>@car.Model</td>
                    <td>@car.Category</td>
                    <td>@car.Price</td>
                    <td>@car.Location</td>
                    <td>@car.Gearbox</td>
                    <td>
                        <button class="btn btn-primary"
                                @onclick="() => BookCar(car.Id)">
                            Book Now
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}


@code {
    [SupplyParameterFromQuery(Name = "location")]
    public string? SearchLocation { get; set; }

    [SupplyParameterFromQuery(Name = "pickup")]
    public DateTime? SearchPickup { get; set; }

    [SupplyParameterFromQuery(Name = "returnDate")]
    public DateTime? SearchReturn { get; set; }

    private List<Car> cars = new();
    private List<Car> filteredCars = new();

    private string searchModel = "";
    private string selectedCategory = "";
    private decimal? maximumPrice;
    private string selectedLocation = "";
    private string selectedGearbox = "";

    
    private bool loading = true;
    private string? errorMessage;

    
    
    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        errorMessage = null;

        try
        {
            if (!string.IsNullOrWhiteSpace(SearchLocation) &&
                SearchPickup.HasValue &&
                SearchReturn.HasValue)
            {
                selectedLocation = SearchLocation;

                if (SearchPickup.Value <= DateTime.Now ||
                    SearchReturn.Value <= SearchPickup.Value)
                {
                    errorMessage =
                        "Please select a future pickup date and a return date after the pickup date.";

                    cars = new List<Car>();
                    filteredCars = new List<Car>();
                    return;
                }

                List<Location> locations =
                    await LocationApiService.GetAllLocationsAsync();

                Location? selected =
                    locations.FirstOrDefault(location =>
                        location.Name.Equals(
                            SearchLocation.Trim(),
                            StringComparison.OrdinalIgnoreCase));

                
                
                if (selected == null)
                {
                    errorMessage =
                        "The selected location was not found.";

                    cars = new List<Car>();
                    filteredCars = new List<Car>();
                    return;
                }

                
cars = await CarApiService.GetAvailableCarsAsync(
    selected.Id,
    SearchPickup.Value,
    SearchReturn.Value);

            }
            else
            {
                selectedLocation = "";
                cars = await CarApiService.GetAllCarsAsync();
            }

            filteredCars = cars.ToList();
        }
        
        catch (Exception ex)
        {
            
            errorMessage = GetFriendlyError(ex);
            cars = new List<Car>();
            filteredCars = new List<Car>();
        }
        
        finally
        {
            
            loading = false;
        }
    }

    private string GetFriendlyError(Exception ex)
    {
        if (ex.Message ==
            "Unable to connect to the service. Please try again later." ||
            ex.Message ==
            "The request timed out. Please try again.")
        {
            
            return ex.Message;
        }
        

        foreach (System.Net.HttpStatusCode code in
                 Enum.GetValues<System.Net.HttpStatusCode>())
        {
            if (ex.Message == ApiErrorHelper.GetErrorMessage(code))
            {
                
                return ex.Message;
            }
            
        }
        

        return "Unable to load cars. Please try again later.";
    }

    private void SearchCars()
    {
        filteredCars = cars.Where(car =>
            car.Model.Contains(
                searchModel,
                StringComparison.OrdinalIgnoreCase) &&

            (selectedCategory == "" ||
             car.Category == selectedCategory) &&

            (!maximumPrice.HasValue ||
             car.Price <= maximumPrice.Value) &&

            (selectedLocation == "" ||
             car.Location.Equals(
                 selectedLocation,
                 StringComparison.OrdinalIgnoreCase)) &&

            (selectedGearbox == "" ||
             car.Gearbox == selectedGearbox)
        ).ToList();
    }


private void ClearSearch()
{
    searchModel = "";
    selectedCategory = "";
    maximumPrice = null;
    selectedLocation = SearchLocation ?? "";
    selectedGearbox = "";


    filteredCars = cars.ToList();
}



    private void BookCar(long vehicleId)
    {
        string url = $"/book-car/{vehicleId}";

        if (SearchPickup.HasValue && SearchReturn.HasValue)
        {
            url += $"?pickup={SearchPickup.Value:yyyy-MM-ddTHH:mm}" +
                   $"&returnDate={SearchReturn.Value:yyyy-MM-ddTHH:mm}";
        }

        Navigation.NavigateTo(url);
    }
}
