@page "/register"
@rendermode InteractiveServer
@using DriVIABlazor.Models
@using DriVIABlazor.Services

@inject IRegistrationService RegistrationService

<PageTitle>Register - DriVIA</PageTitle>

<h3>Create Customer Account</h3>

<div class="mb-3">
    <label>Username</label>
    <input class="form-control"
           type="text"
           @bind="registrationRequest.Username"
           disabled="@isLoading" />
</div>

<div class="mb-3">
    <label>Password</label>
    <input class="form-control"
           type="password"
           @bind="registrationRequest.Password"
           disabled="@isLoading" />
</div>

<div class="mb-3">
    <label>Confirm Password</label>
    <input class="form-control"
           type="password"
           @bind="confirmPassword"
           disabled="@isLoading" />
</div>

<button class="btn btn-primary"
        @onclick="HandleRegistration"
        disabled="@isLoading">
    @(isLoading ? "Creating account..." : "Create Account")
</button>


<p class="mt-3">@message</p>

<p>
    Already have an account?
    <a href="/login">Login</a>
</p>

@code {
    private RegistrationRequest registrationRequest = new();
    private string confirmPassword = "";
    private string message = "";
    private bool isLoading = false;
    
    private async Task HandleRegistration()
    {
        message = "";

        if (string.IsNullOrWhiteSpace(registrationRequest.Username))
        {
            message = "Please enter a username.";
            return;
        }

        if (string.IsNullOrWhiteSpace(registrationRequest.Password))
        {
            message = "Please enter a password.";
            return;
        }

        if (registrationRequest.Password.Length < 8)
        {
            message = "Password must contain at least 8 characters.";
            return;
        }

        if (registrationRequest.Password != confirmPassword)
        {
            message = "Passwords do not match.";
            return;
        }

        isLoading = true;

        try
        {
            bool success =
                await RegistrationService.RegisterAsync(registrationRequest);

            if (success)
            {
                message = "Account created successfully! You can now log in.";

                registrationRequest = new RegistrationRequest();
                confirmPassword = "";
            }
            else
            {
                message = "Registration failed. Please check your information.";
            }
        }
        catch (HttpRequestException)
        {
            message = "Cannot connect to the server.";
        }
        catch (Exception)
        {
            message = "Registration failed. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}