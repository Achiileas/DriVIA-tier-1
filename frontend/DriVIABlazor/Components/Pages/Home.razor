@page "/"
@rendermode InteractiveServer

@using DriVIABlazor.Models
@using DriVIABlazor.Services
@inject NavigationManager Navigation
@inject LocationApiService LocationApiService

<PageTitle>DriVIA - Car Rental</PageTitle>

<div class="home-page">

    <section class="hero-section">
        <img src="/images/BMW-driving.jpg"
             alt="Blue BMW driving through the mountains"
             class="hero-image" />

        <div class="hero-content">
            <h1>Your journey starts here.</h1>
            <p>Find the perfect car for your next adventure.</p>
        </div>
    </section>

    <section class="search-section">

        <h2>Find your rental car</h2>

        <p class="search-description">
            Choose your location and rental dates to get started.
        </p>

        <div class="search-form">

            <div class="form-field location-field">
                <label for="location">Pick-up location</label>

                <select id="location"
                        @bind="location"
                        disabled="@loadingLocations">
                    <option value="">Choose a location</option>

                    @foreach (var item in locations)
                    {
                        <option value="@item.Name">
                            @item.Name
                        </option>
                    }
                </select>
            </div>

            <div class="form-field">
                <label for="pickupDate">Pick-up date</label>
                <input id="pickupDate"
                       type="date"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       @bind="pickupDate" />
            </div>

            <div class="form-field">
                <label for="pickupTime">Pick-up time</label>
                <input id="pickupTime"
                       type="time"
                       @bind="pickupTime" />
            </div>

            <div class="form-field">
                <label for="returnDate">Return date</label>
                <input id="returnDate"
                       type="date"
                       min="@pickupDate.ToString("yyyy-MM-dd")"
                       @bind="returnDate" />
            </div>

            <div class="form-field">
                <label for="returnTime">Return time</label>
                <input id="returnTime"
                       type="time"
                       @bind="returnTime" />
            </div>

            <button class="search-button"
                    @onclick="SearchCars"
                    disabled="@loadingLocations">
                Search available cars
            </button>

        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p class="error-message">@errorMessage</p>
        }

    </section>

</div>

@code {
    private List<Location> locations = new();

    private string location = "";

    private DateTime pickupDate = DateTime.Today;
    private TimeOnly pickupTime = new(10, 0);

    private DateTime returnDate = DateTime.Today.AddDays(1);
    private TimeOnly returnTime = new(10, 0);

    private string errorMessage = "";
    private bool loadingLocations = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            locations = await LocationApiService.GetAllLocationsAsync();
        }
        catch (Exception)
        {
            errorMessage = "Could not load rental locations.";
        }
        finally
        {
            loadingLocations = false;
        }
    }

    private void SearchCars()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(location))
        {
            errorMessage = "Please select a pick-up location.";
            return;
        }

        DateTime pickup =
            pickupDate.Date.Add(pickupTime.ToTimeSpan());

        DateTime dropoff =
            returnDate.Date.Add(returnTime.ToTimeSpan());

        if (pickup <= DateTime.Now ||
            dropoff <= pickup)
        {
            errorMessage = "Invalid selected date.";
            return;
        }

        string url = $"/cars?location={Uri.EscapeDataString(location)}" +
                     $"&pickup={pickup:yyyy-MM-ddTHH:mm}" +
                     $"&returnDate={dropoff:yyyy-MM-ddTHH:mm}";

        Navigation.NavigateTo(url);
    }
}
